{
  "name": "keyrush-3d",
  "version": "1.0.0",
  "description": "KEYRUSH — Type. Race. Dominate. | Esports Motorsport 3D Typing Simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.js",
    "format": "npx prettier --write \"src/**/*.{js,css}\" \"tests/**/*.js\"",
    "format:check": "npx prettier --check \"src/**/*.{js,css}\" \"tests/**/*.js\""
  },
  "keywords": [
    "typing-game",
    "threejs",
    "racing-game",
    "webgl",
    "esports",
    "touch-typing"
  ],
  "author": "Mukteshwar",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.2.5",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "three": "^0.186.1"
  }
}
